---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  icon: ImageMetadata;
  lines: string[];
  variant?: 'mobile' | 'desktop';
}

const { icon, lines, variant = 'desktop' } = Astro.props;
---

{variant === 'mobile' ? (
  <div class="flex h-[147px] w-full flex-col items-center justify-center rounded-[5px] bg-white/10 px-3 text-center backdrop-blur-sm">
    <div class="flex h-[40px] w-full items-center justify-center">
      <Image
        src={icon}
        alt=""
        aria-hidden="true"
        loading="eager"
        class="icon-shadow-mobile max-h-[38px] w-auto max-w-[36px] select-none object-contain"
      />
    </div>
    <p class="mt-4 text-[15px] font-medium leading-[1.3] text-white">
      {lines.map((line, i) => (
        <>
          {line}
          {i < lines.length - 1 && <br />}
        </>
      ))}
    </p>
  </div>
) : (
  <div class="flex flex-col items-start text-left">
    <div class="flex w-bullet-icon items-start justify-center">
      <Image
        src={icon}
        width={icon.width}
        height={icon.height}
        alt=""
        aria-hidden="true"
        loading="eager"
        class="icon-shadow-desktop h-auto w-auto max-h-bullet-icon-h max-w-bullet-icon select-none"
      />
    </div>
    <p class="mt-bullet-mt text-bullet font-medium leading-[1.3] text-white">
      {lines.map((line, i) => (
        <>
          {line}
          {i < lines.length - 1 && <br />}
        </>
      ))}
    </p>
  </div>
)}
