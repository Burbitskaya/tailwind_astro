---
interface Props {
  icon: ImageMetadata;
  label: string;
  href: string;
}

const { icon, label, href } = Astro.props;
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={`Загрузить в ${label}`}
  class="inline-flex h-[56px] w-full items-center justify-center rounded-[5px] bg-white px-5 shadow-[0_10px_20px_rgba(0,0,0,0.1)] transition hover:bg-neutral-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white sm:h-[60px] min-[1300px]:h-[70px]! min-[1300px]:w-auto"
>
  <!-- Контейнер иконки: ширина 30px, центр иконки в 15px от её края -->
  <div class="flex w-[30px] shrink-0 items-center justify-center">
    <img
      src={icon.src}
      width={icon.width}
      height={icon.height}
      alt=""
      aria-hidden="true"
      class="h-6 w-auto select-none object-contain min-[1300px]:h-8"
    />
  </div>

  <!-- От центра иконки (35px от края кнопки) до начала текста (65px) — ровно 30px -->
  <span class="ml-[15px] flex items-baseline gap-1.5 whitespace-nowrap text-sm leading-tight min-[1300px]:text-[18px]">
    <span class="font-normal text-[#250804]/60">Загрузить в</span>
    <span class="font-medium text-[#250804]">{label}</span>
  </span>
</a>
