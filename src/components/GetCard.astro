---
import { Image } from 'astro:assets';
import card from '../assets/card.png';
import maskCard from '../assets/Mask_card.png';
import googlePay from '../assets/google-pay.svg';
import visaPay from '../assets/visa-pay.svg';
import applePay from '../assets/apple-pay.svg';
import blueLong from '../assets/blue_long.png';
import blueMobile from '../assets/blue-mobile.png';
---

<section
  id="get-card"
  class="relative mx-auto w-full max-w-[1753px] overflow-hidden rounded-[15px] border border-white/10 bg-white/[0.05] px-5 py-8 backdrop-blur-[25px] sm:px-8 sm:py-10 md:px-10 lg:px-[70px] lg:py-[25px] min-[1280px]:h-[409px]"
>
  <!-- Фон для get card: blue_long (десктоп/планшет) и blue-mobile (мобилка) -->
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <Image
      src={blueMobile}
      alt=""
      class="absolute bottom-0 left-1/2 -translate-x-1/2 w-full max-w-none select-none sm:hidden"
    />
    <Image
      src={blueLong}
      alt=""
      class="hidden sm:block absolute bottom-0 left-1/2 -translate-x-1/2 w-full max-w-[1753px] select-none"
    />
  </div>

  <!-- Контент панели GetCard -->
  <div
    class="relative z-10 flex h-full flex-col items-center justify-between gap-8 text-center sm:flex-row sm:items-center sm:text-left min-[1280px]:justify-start min-[1280px]:gap-0"
  >
    <!-- Первая колонка: Заголовок, описание и логотипы -->
    <div
      class="flex w-full max-w-[573px] flex-col items-center sm:w-auto sm:items-start sm:shrink-0 lg:max-w-[573px]"
    >
      <h2
        class="text-[28px] font-bold uppercase leading-none tracking-tight text-white sm:text-[34px] md:text-[38px] lg:text-[50px]"
      >
        Получи карту
      </h2>
      <p
        class="mt-3 text-[15px] leading-[1.4] text-white/70 sm:mt-4 sm:text-[16px] md:text-[18px] lg:mt-5 lg:text-[22px]"
      >
        Мгновенный выпуск, любая валюта, использование по всему миру, абсолютная свобода.
      </p>

      <!-- Способы оплаты -->
      <div
        class="mt-6 flex flex-wrap items-center justify-center gap-[9.11px] sm:mt-7 sm:justify-start lg:mt-[68px]"
      >
        <Image
          src={googlePay}
          alt="Google Pay"
          width={googlePay.width}
          height={googlePay.height}
          class="h-[36px] w-auto select-none sm:h-[40px] lg:h-[50px]"
        />
        <img
          src={visaPay.src}
          alt="Visa"
          width={84}
          height={50}
          class="h-[36px] w-auto select-none sm:h-[40px] lg:h-[50px]"
        />
        <Image
          src={applePay}
          alt="Apple Pay"
          width={applePay.width}
          height={applePay.height}
          class="h-[36px] w-auto select-none sm:h-[40px] lg:h-[50px]"
        />
      </div>
    </div>

    <!-- Вторая колонка: Карточка Visa
         - На десктопе (min-[1280px]:): изначально ровно 20px от текста, размер 577x359, не по центру!
         - На планшетах (sm до 1280px): уменьшается пропорционально (clamp(280px,34vw,460px)),
           а кнопка «Заказать карту» переносится под карточку и они становятся строго одной ширины!
         - На мобилке (<sm): в колонку, карточка и кнопка одной ширины max-w-[340px]
    -->
    <div
      class="relative my-auto flex w-full max-w-[340px] flex-col items-center justify-center self-center sm:my-auto sm:w-[clamp(280px,34vw,460px)] sm:max-w-none sm:shrink-0 min-[1280px]:w-[577px] min-[1280px]:ml-[20px]"
    >
      <div class="relative w-full">
        <Image
          src={card}
          alt="Банковская карта Доверка"
          width={577}
          height={359}
          class="h-auto w-full select-none drop-shadow-[0_40px_60px_rgba(0,0,0,0.45)]"
          loading="lazy"
        />

        <!-- Наложение маски карты Mask_card -->
        <Image
          src={maskCard}
          alt=""
          width={577}
          height={359}
          class="pointer-events-none absolute inset-0 h-full w-full select-none object-cover"
          aria-hidden="true"
        />
      </div>

      <!-- Кнопка «Заказать карту» для планшета и мобилки:
           Переносится строго под карточку и имеет ТОЧНО ТАКУЮ ЖЕ ширину (w-full)
      -->
      <div class="mt-4 flex w-full justify-center sm:mt-5 min-[1280px]:hidden">
        <a
          href="#order"
          class="inline-flex h-[52px] w-full items-center justify-center rounded-[5px] border border-white/5 bg-white/10 px-6 text-[16px] font-medium text-white shadow-[0_20px_30px_rgba(0,0,0,0.1)] transition hover:bg-white/20 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white sm:h-[54px] md:h-[58px]"
        >
          Заказать карту
        </a>
      </div>
    </div>

    <!-- Третья колонка (десктоп от 1280px): кнопка справа по центру -->
    <div class="hidden min-[1280px]:flex min-[1280px]:flex-1 min-[1280px]:h-full min-[1280px]:items-center min-[1280px]:justify-center">
      <a
        href="#order"
        class="inline-flex h-[62px] w-[201px] items-center justify-center rounded-[5px] border border-white/5 bg-white/10 px-8 text-[18px] font-medium text-white shadow-[0_20px_30px_rgba(0,0,0,0.1)] transition hover:bg-white/20 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
      >
        Заказать карту
      </a>
    </div>
  </div>
</section>
