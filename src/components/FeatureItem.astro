---
interface Props {
  icon: ImageMetadata;
  lines: string[];
  variant?: 'mobile' | 'desktop';
}

const { icon, lines, variant = 'desktop' } = Astro.props;
---

{
  variant === 'mobile' ? (
    <div class="flex min-h-[140px] w-full flex-col items-center rounded-[5px] bg-white/10 px-3 py-5 text-center backdrop-blur-sm">
      <div class="icon-shadow-mobile flex h-[36px] w-[34px] items-center justify-center">
        <img
          src={icon.src}
          width={icon.width}
          height={icon.height}
          alt=""
          aria-hidden="true"
          class="h-auto max-h-[36px] w-auto max-w-[34px] select-none"
        />
      </div>
      <p class="mt-3 text-[15px] font-medium leading-[1.3] text-white">
        {lines.map((line, i) => (
          <>
            {line}
            {i < lines.length - 1 && <br />}
          </>
        ))}
      </p>
    </div>
  ) : (
    <div class="flex flex-col items-start text-left">
      <div class="icon-shadow-desktop flex w-[clamp(26px,12px+1.56vw,42px)] items-start justify-center">
        <img
          src={icon.src}
          width={icon.width}
          height={icon.height}
          alt=""
          aria-hidden="true"
          class="h-auto w-auto max-h-[clamp(28px,13px+1.66vw,45px)] max-w-[clamp(26px,12px+1.56vw,42px)] select-none"
        />
      </div>
      <p class="mt-[clamp(12px,4px+1.35vw,30px)] text-[clamp(13px,6px+0.83vw,22px)] font-medium leading-snug text-white">
        {lines.map((line, i) => (
          <>
            {line}
            {i < lines.length - 1 && <br />}
          </>
        ))}
      </p>
    </div>
  )
}
