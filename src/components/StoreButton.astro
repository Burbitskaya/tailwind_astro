---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  icon: ImageMetadata;
  label: string;
  href: string;
}

const { icon, label, href } = Astro.props;
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={`Загрузить в ${label}`}
  class="inline-flex h-[56px] w-full items-center justify-center rounded-[5px] bg-white px-5 shadow-[0_10px_20px_rgba(0,0,0,0.1)] transition hover:bg-neutral-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white sm:h-[60px] min-[1300px]:h-[70px] min-[1300px]:w-auto"
>
  <div class="flex w-6 shrink-0 items-center justify-center sm:w-8">
    <Image
      src={icon}
      width={icon.width}
      height={icon.height}
      alt=""
      aria-hidden="true"
      loading="lazy"
      class="h-6 w-auto select-none object-contain sm:h-8"
    />
  </div>

  <span class="ml-2.5 flex items-baseline gap-1.5 whitespace-nowrap text-[14px] leading-tight sm:ml-3.5 sm:text-[18px]">
    <span class="font-normal text-brand-dark/60">Загрузить в</span>
    <span class="font-medium text-brand-dark">{label}</span>
  </span>
</a>
