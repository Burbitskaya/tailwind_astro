---
import Layout from '../layouts/Layout.astro';
import FeatureItem from '../components/FeatureItem.astro';
import PhoneMockup from '../components/PhoneMockup.astro';
import StoreButton from '../components/StoreButton.astro';
import GetCard from '../components/GetCard.astro';
import { Image } from 'astro:assets';

import heroGradient from '../assets/hero-gradient.svg';
import shadowLight from '../assets/shadow_light.svg';
import backMobile from '../assets/back.svg';

import {
  featuresLeft,
  featuresRight,
  featuresMobile,
  stores,
} from '../data/landing';
---

<Layout title="Доверка — все переводы в одном приложении">
  <main class="relative isolate min-h-screen overflow-hidden bg-page-bg pb-[84px] text-white">
    <div
      class="pointer-events-none absolute inset-0 -z-10 block overflow-hidden sm:hidden"
      aria-hidden="true"
    >
      <Image
        src={backMobile}
        alt=""
        loading="eager"
        class="absolute inset-0 h-full w-full select-none object-fill"
      />
    </div>

    <div
      class="pointer-events-none absolute inset-0 -z-10 hidden overflow-hidden sm:block"
      aria-hidden="true"
    >
      <Image
        src={heroGradient}
        alt=""
        loading="eager"
        class="absolute inset-x-0 top-0 h-[2106px] w-full select-none object-fill"
      />
      <Image
        src={shadowLight}
        alt=""
        loading="eager"
        class="absolute inset-0 h-full w-full select-none object-fill"
      />
    </div>

    <div class="mx-auto flex w-full max-w-[1920px] flex-col items-center px-5 pt-hero-pt sm:px-6 lg:px-6 min-[1920px]:px-0">
      <div class="relative flex w-full flex-col items-center sm:justify-start lg:max-w-[1920px]">
        <section class="relative z-20 flex w-full flex-col items-center gap-[20px] text-center sm:max-w-[640px] lg:max-w-[831px] lg:gap-[20px]">
          <h1 class="text-[35px] font-bold uppercase leading-[1.12] tracking-tight text-white sm:text-[46px] md:text-[52px] lg:text-[64px] lg:leading-[1.2]">
            Все переводы
            <span class="block">в&nbsp;одном приложении</span>
          </h1>
          <p class="text-[16px] font-normal leading-[1.4] text-white/80 sm:text-[18px] lg:text-[22px]">
            Все статусы, история и&nbsp;поддержка&nbsp;— прямо в&nbsp;приложении
          </p>
        </section>

        <div class="mt-[30px] flex w-full justify-center sm:hidden">
          <ul
            role="list"
            aria-label="Преимущества приложения"
            class="grid w-full grid-cols-2 gap-x-[7px] gap-y-[8px]"
          >
            {featuresMobile.map((feature) => (
              <li>
                <FeatureItem {...feature} variant="mobile" />
              </li>
            ))}
          </ul>
        </div>

        <div class="-mx-5 mt-0 w-auto sm:hidden">
          <PhoneMockup />
        </div>

        <div class="relative hidden w-full justify-center sm:flex sm:-mt-4 md:-mt-6 xl:-mt-[31px]">
          <div class="pointer-events-none relative flex w-mockup max-w-full justify-center">
            <PhoneMockup class="w-full" />

            <div
              class="pointer-events-auto absolute inset-x-0 top-[18%] z-10 mx-auto flex h-[50%] w-[87.2%] justify-between lg:top-[20%] lg:h-[48%]"
              aria-label="Преимущества приложения"
            >
              <ul
                role="list"
                class="flex h-full flex-col justify-between gap-6 md:gap-8 lg:gap-10"
              >
                {featuresLeft.map((feature) => (
                  <li>
                    <FeatureItem {...feature} variant="desktop" />
                  </li>
                ))}
              </ul>
              <ul
                role="list"
                class="flex h-full flex-col justify-between gap-6 md:gap-8 lg:gap-10"
              >
                {featuresRight.map((feature) => (
                  <li>
                    <FeatureItem {...feature} variant="desktop" />
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>

        <section
          class="relative z-10 -mt-[15.6vw] grid w-full grid-cols-1 gap-2 sm:mt-0 sm:max-w-[680px] sm:grid-cols-2 sm:gap-3.5 min-[1300px]:flex min-[1300px]:max-w-[1170px] min-[1300px]:flex-row min-[1300px]:items-center min-[1300px]:justify-center min-[1300px]:gap-3.5 min-[1300px]:h-[70px]"
          aria-label="Скачать приложение"
        >
          {stores.map((store) => (
            <StoreButton {...store} />
          ))}
        </section>
      </div>

      <div class="mt-[100px] sm:mt-card-gap flex w-full justify-center">
        <GetCard />
      </div>
    </div>
  </main>
</Layout>
