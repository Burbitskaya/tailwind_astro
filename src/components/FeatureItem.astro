---
interface Props {
  icon: ImageMetadata;
  lines: string[];
  variant?: 'mobile' | 'desktop';
}

const { icon, lines, variant = 'desktop' } = Astro.props;
const isBonuses = icon.src.includes('bonuses');
---

{variant === 'mobile' ? (
  <div class="flex h-[147px] w-full items-center justify-center rounded-[5px] bg-white/10 text-center backdrop-blur-sm">
    <!-- Внутренний блок по центру: иконка прижата к верхнему краю, текст к нижнему (Figma 6004:25336) -->
    <div class="flex h-[104px] w-full max-w-[133px] flex-col items-center justify-between">
      <div class="icon-shadow-mobile flex shrink-0 items-center justify-center">
        <img
          src={icon.src}
          width={isBonuses ? 34 : icon.width}
          height={isBonuses ? 34 : icon.height}
          alt=""
          aria-hidden="true"
          class:list={[
            'icon-shadow-mobile select-none object-contain',
            isBonuses
              ? 'h-[34px] w-[34px]'
              : 'h-auto max-h-[38px] w-auto max-w-[36px]',
          ]}
        />
      </div>
      <p class="text-[15px] font-medium leading-[1.3] text-white">
        {lines.map((line, i) => (
          <>
            {line}
            {i < lines.length - 1 && <br />}
          </>
        ))}
      </p>
    </div>
  </div>
) : (
  <div class="flex flex-col items-start text-left">
    <!-- Иконка: 45x42 на экранах от 1440 до 1920, ниже 1440 плавно уменьшается -->
    <div class="icon-shadow-desktop flex w-[clamp(28px,16.8px+1.75vw,42px)] items-start justify-center">
      <img
        src={icon.src}
        width={icon.width}
        height={icon.height}
        alt=""
        aria-hidden="true"
        class="icon-shadow-desktop h-auto w-auto max-h-[clamp(30px,18px+1.875vw,45px)] max-w-[clamp(28px,16.8px+1.75vw,42px)] select-none"
      />
    </div>
    <!-- Текст и отступ: 22px и 30px на экранах от 1440 до 1920, ниже 1440 плавно уменьшаются, чтобы строки не схлопывались -->
    <p class="mt-[clamp(12px,-2.4px+2.25vw,30px)] text-[clamp(16px,11.2px+0.75vw,22px)] font-medium leading-[1.3] text-white">
      {lines.map((line, i) => (
        <>
          {line}
          {i < lines.length - 1 && <br />}
        </>
      ))}
    </p>
  </div>
)}
