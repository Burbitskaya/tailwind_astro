---
import Layout from '../layouts/Layout.astro';
import FeatureItem from '../components/FeatureItem.astro';
import PhoneMockup from '../components/PhoneMockup.astro';
import StoreButton from '../components/StoreButton.astro';
import GetCard from '../components/GetCard.astro';

import heroGradient from '../assets/hero-gradient.svg';
import shadowLight from '../assets/shadow_light.svg';
import backMobile from '../assets/back.svg';
import bulletSpeed from '../assets/bullet-speed.svg';
import bulletTransfers from '../assets/bullet-transfers.svg';
import bulletBonuses from '../assets/bullet-bonuses.svg';
import bulletSupport from '../assets/bullet-support.svg';

import btnIconGooglePlay from '../assets/btn-icon-google-play.svg';
import btnIconAppStore from '../assets/btn-icon-app-store.svg';
import btnIconAppGallery from '../assets/btn-icon-app-gallery.svg';
import btnIconRuStore from '../assets/btn-icon-rustore.svg';

const featuresLeft = [
  {
    icon: bulletSpeed,
    lines: ['Без задержек и', 'сюрпризов'],
  },
  {
    icon: bulletTransfers,
    lines: ['Все переводы в', 'одном месте'],
  },
];

const featuresRight = [
  {
    icon: bulletBonuses,
    lines: ['Бонусы и скидки', 'на комиссии'],
  },
  {
    icon: bulletSupport,
    lines: ['Поддержка', '24/7'],
  },
];

const stores = [
  {
    icon: btnIconGooglePlay,
    label: 'Google Play',
    href: 'https://play.google.com/store/apps',
  },
  {
    icon: btnIconAppStore,
    label: 'App Store',
    href: 'https://www.apple.com/app-store/',
  },
  {
    icon: btnIconAppGallery,
    label: 'AppGallery',
    href: 'https://appgallery.huawei.com/',
  },
  {
    icon: btnIconRuStore,
    label: 'RuStore',
    href: 'https://www.rustore.ru/',
  },
];
---

<Layout title="Доверка — все переводы в одном приложении">
  <main class="relative isolate min-h-screen overflow-hidden bg-[#050505] pb-[84px] text-white">
    <!--
      Фон:
      - Мобильная версия (<sm): отдельный фон back.svg (375x2267) из мобильного фрейма Figma
      - Десктоп/планшет (sm+): hero-gradient (радиальный 2106px) + shadow_light (растянут на всю высоту страницы)
      Оба фона всегда начинаются строго сверху (top-0).
    -->
    <!-- Мобильный фон (< sm) -->
    <div
      class="pointer-events-none absolute inset-0 -z-10 block overflow-hidden sm:hidden"
      aria-hidden="true"
    >
      <img
        src={backMobile.src}
        alt=""
        class="absolute inset-0 h-full w-full select-none object-fill"
      />
    </div>

    <!-- Десктопный и планшетный фон (sm и выше) -->
    <div
      class="pointer-events-none absolute inset-0 -z-10 hidden overflow-hidden sm:block"
      aria-hidden="true"
    >
      <!-- hero-gradient: ограничен 2106px, привязан к верхнему краю -->
      <img
        src={heroGradient.src}
        alt=""
        class="absolute inset-x-0 top-0 h-[2106px] w-full select-none object-fill"
      />
      <!-- shadow_light: растягивается на всю высоту страницы от начала до конца ленты -->
      <img
        src={shadowLight.src}
        alt=""
        class="absolute inset-0 h-full w-full select-none object-fill"
      />
    </div>

    <!--
      Внешний контейнер:
      Отступ сверху плавно уменьшается от 491px (1920px) до 185px (375px)
    -->
    <div
      class="mx-auto flex w-full max-w-[1920px] flex-col items-center px-4 pt-[clamp(185px,110px+19.8vw,491px)] sm:px-6 lg:px-6 min-[1920px]:px-0"
    >
      <!--
        Основной контейнер hero:
        Заканчивается кнопками загрузки, без искусственного пустого зазора снизу
      -->
      <div
        class="relative flex w-full flex-col items-center sm:justify-start lg:max-w-[1920px]"
      >
        <!--
          Заголовок Hero:
          - 375px: ширина 335, gap 15, h1: 35/112%, p: 16/140%
          - 1920px: ширина 831, высота 205, gap 20, h1: 64/120%, p: 22/140%
        -->
        <section
          class="relative z-20 flex w-full max-w-[335px] flex-col items-center gap-[15px] text-center sm:max-w-[640px] lg:max-w-[831px] lg:gap-[20px]"
        >
          <h1
            class="text-[35px] font-bold uppercase leading-[1.12] tracking-tight text-white sm:text-[46px] md:text-[52px] lg:text-[64px] lg:leading-[1.2]"
          >
            Все переводы
            <span class="block">в одном приложении</span>
          </h1>
          <p
            class="text-[16px] font-normal leading-[1.4] text-white/80 sm:text-[18px] lg:text-[22px]"
          >
            Все статусы, история и поддержка — прямо в приложении
          </p>
        </section>

        <!--
          МОБИЛЬНАЯ ВЕРСИЯ (< 640px):
          Буллеты 335×302, gap-x: 7, gap-y: 8
          Каждый: 164×147, rounded-5, bg-white/10, padding 30×27
          Потом mobile_phone во всю ширину
        -->
        <div class="mt-8 flex w-full justify-center sm:hidden">
          <div class="grid w-full grid-cols-2 gap-2">
            <FeatureItem {...featuresLeft[0]} variant="mobile" />
            <FeatureItem {...featuresRight[0]} variant="mobile" />
            <FeatureItem {...featuresLeft[1]} variant="mobile" />
            <FeatureItem {...featuresRight[1]} variant="mobile" />
          </div>
        </div>

        <div class="-mx-4 mt-0 w-[calc(100%+2rem)] max-w-none sm:hidden">
          <PhoneMockup />
        </div>

        <!--
          ПЛАНШЕТНАЯ И ДЕСКТОПНАЯ ВЕРСИЯ (sm: и выше):
          Композиция — смартфон по центру, буллеты по 4 углам поверх него.
          Соотношение сторон мокапа строго сохраняется, без деформации.
          Рука масштабируется плавно и мягко, не уменьшаясь слишком сильно.
        -->
        <div
          class="relative hidden w-full justify-center sm:flex sm:-mt-4 md:-mt-6 xl:-mt-[31px]"
        >
          <!-- Мокап по центру: рука крупная, масштабируется плавно -->
          <div class="pointer-events-none relative flex w-[clamp(780px,28vw+540px,1080px)] max-w-full justify-center">
            <PhoneMockup class="w-full" />

            <!-- Буллеты: 4 угла, всегда занимают тот же процент от высоты картинки с рукой -->
            <div
              class="pointer-events-auto absolute inset-x-0 top-[20%] z-10 mx-auto flex h-[46%] w-[87.2%] justify-between"
            >
              <div class="flex h-full flex-col justify-between">
                <FeatureItem {...featuresLeft[0]} variant="desktop" />
                <FeatureItem {...featuresLeft[1]} variant="desktop" />
              </div>
              <div class="flex h-full flex-col justify-between">
                <FeatureItem {...featuresRight[0]} variant="desktop" />
                <FeatureItem {...featuresRight[1]} variant="desktop" />
              </div>
            </div>
          </div>
        </div>

        <!-- Кнопки загрузки: аккуратно под рукой, без заезда на руку -->
        <section
          class="relative z-10 -mt-[31.2vw] grid w-full grid-cols-1 gap-2 sm:mt-0 sm:max-w-[680px] sm:grid-cols-2 sm:gap-3.5 min-[1300px]:flex min-[1300px]:max-w-[1170px] min-[1300px]:flex-row min-[1300px]:items-center min-[1300px]:justify-center min-[1300px]:gap-3.5 min-[1300px]:h-[70px]"
          aria-label="Скачать приложение"
        >
          {stores.map((store) => (
            <StoreButton {...store} />
          ))}
        </section>
      </div>

      <!-- Отступ между основным контейнером и карточкой (150px на 1920, уменьшается пропорционально) -->
      <div class="mt-[clamp(40px,18px+6.875vw,150px)] flex w-full justify-center">
        <GetCard />
      </div>
    </div>
  </main>
</Layout>
