---
import type { ImageMetadata } from 'astro';

interface Props {
  icon: ImageMetadata;
  iconClass: string;
  lines: string[];
}

const { icon, iconClass, lines } = Astro.props;
---

<div class="flex flex-col gap-[30px]">
  <img
    src={icon.src}
    alt=""
    width={icon.width}
    height={icon.height}
    class={`object-contain ${iconClass}`}
    aria-hidden="true"
  />
  <p class="text-[18px] leading-[1.3] font-medium text-white sm:text-[22px]">
    {lines.map((line) => (
      <span class="block">{line}</span>
    ))}
  </p>
</div>
