---
import { Image } from 'astro:assets';
import card from '../assets/card.png';
import maskCard from '../assets/Mask_card.png';
import googlePay from '../assets/google-pay.svg';
import visaPay from '../assets/visa-pay.svg';
import applePay from '../assets/apple-pay.svg';
import blueLong from '../assets/blue_long.png';
import blueMobile from '../assets/blue-mobile.png';
---

<section
  id="get-card"
  class="relative mx-auto w-full overflow-hidden rounded-[15px] border border-white/10 bg-white/[0.05] backdrop-blur-[25px] sm:max-w-[1753px] lg:min-h-[330px] xl:min-h-[370px] 2xl:min-h-[409px] lg:aspect-[1753/409]"
>
  <div
    class="pointer-events-none absolute inset-0 overflow-hidden"
    aria-hidden="true"
  >
    <Image
      src={blueMobile}
      alt=""
      loading="lazy"
      class="absolute bottom-0 left-1/2 -translate-x-1/2 w-full max-w-none select-none sm:hidden"
    />
    <Image
      src={blueLong}
      alt=""
      loading="lazy"
      class="hidden sm:block absolute bottom-0 left-1/2 -translate-x-1/2 w-full max-w-[1753px] select-none"
    />
  </div>

  <div class="relative z-10 grid h-full grid-cols-1 items-center gap-6 px-5 py-8 text-center sm:grid-cols-[1fr_clamp(280px,36vw,380px)] sm:gap-x-8 sm:gap-y-4 sm:p-8 sm:text-left md:p-10 lg:grid-cols-[40%_33%_1fr] xl:grid-cols-[38%_35%_1fr] lg:gap-0 lg:px-0 lg:py-4 xl:py-0">
    <div class="flex flex-col items-center sm:row-span-2 sm:items-start lg:row-span-1 lg:pl-card-pad lg:pr-4">
      <h2 class="text-card-title whitespace-nowrap font-bold uppercase leading-tight tracking-tight text-white lg:leading-[1.2]">
        Получи карту
      </h2>
      <p class="mt-3 text-card-desc leading-[1.4] text-white/70 lg:mt-5">
        Мгновенный выпуск, любая валюта, <br class="hidden xl:inline" />
        использование по&nbsp;всему миру, абсолютная свобода.
      </p>

      <div class="mt-6 flex flex-wrap items-center justify-center gap-2.5 sm:justify-start lg:mt-[clamp(24px,2.5vw,48px)] 2xl:mt-[68px]">
        <Image
          src={googlePay}
          alt="Google Pay"
          width={googlePay.width}
          height={googlePay.height}
          loading="lazy"
          class="h-pay-h w-auto select-none"
        />
        <Image
          src={visaPay}
          alt="Visa"
          width={84}
          height={50}
          loading="lazy"
          class="h-pay-h w-auto select-none"
        />
        <Image
          src={applePay}
          alt="Apple Pay"
          width={applePay.width}
          height={applePay.height}
          loading="lazy"
          class="h-pay-h w-auto select-none"
        />
      </div>
    </div>

    <div class="relative mx-auto flex w-full max-w-[340px] flex-col items-center justify-center sm:max-w-none lg:max-w-[577px] lg:justify-self-center">
      <div class="relative w-full">
        <Image
          src={card}
          alt="Банковская карта Доверка"
          width={577}
          height={359}
          loading="lazy"
          decoding="async"
          class="h-auto w-full select-none"
        />
        <Image
          src={maskCard}
          alt=""
          width={577}
          height={359}
          loading="lazy"
          decoding="async"
          class="pointer-events-none absolute inset-0 h-full w-full select-none object-cover"
          aria-hidden="true"
        />
      </div>
    </div>

    <div class="flex w-full justify-center sm:col-start-2 sm:row-start-2 lg:col-start-3 lg:row-start-1 lg:h-full lg:items-center">
      <a
        href="#order"
        class="inline-flex h-card-btn-h w-full max-w-[340px] items-center justify-center whitespace-nowrap rounded-[5px] border border-white/5 bg-white/10 px-6 text-card-btn font-medium text-white shadow-[0_20px_30px_rgba(0,0,0,0.1)] transition hover:bg-white/20 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white sm:max-w-none lg:w-card-btn-w"
      >
        Заказать карту
      </a>
    </div>
  </div>
</section>
