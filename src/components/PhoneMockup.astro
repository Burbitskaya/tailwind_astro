---
import { Image } from 'astro:assets';
import phoneMockup from '../assets/phone-mockup.png';
import mobilePhone from '../assets/mobile_phone.png';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class:list={['relative', className]}>
  <Image
    src={mobilePhone}
    alt="Приложение Доверка на экране смартфона"
    class="block h-auto w-full select-none sm:hidden"
    loading="eager"
  />

  <Image
    src={phoneMockup}
    alt="Приложение Доверка на экране смартфона"
    class="hidden h-auto w-full aspect-[2280/1560] select-none object-contain drop-shadow-[0_20px_50px_rgba(0,0,0,0.6)] sm:block"
    loading="eager"
  />
</div>
